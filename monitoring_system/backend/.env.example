PORT=4300

DB_HOST=127.0.0.1
DB_PORT=55433
DB_NAME=monitoring_platform
DB_USER=postgres
DB_PASS=postgres
DB_SYNC=true

JWT_SECRET=<your-jwt-secret>
JWT_EXPIRES_IN=12h

ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>
ADMIN_DISPLAY_NAME=Kufi Monitoring Owner
ADMIN_TITLE=Platform Lead
ADMIN_LOCALE=vi

# Dedicated read-only connector to the wallet platform database.
WALLET_DB_HOST=127.0.0.1
WALLET_DB_PORT=55432
WALLET_DB_NAME=wallet_platform
WALLET_DB_USER=postgres
WALLET_DB_PASS=postgres

# Health probes for the current local stack.
MONITORED_SERVICE_ENDPOINTS=api-gateway=http://127.0.0.1:3000/healthz;auth-service=http://127.0.0.1:3001/healthz;transaction-service=http://127.0.0.1:3002/healthz;outside-payment-service=http://127.0.0.1:3003/healthz;chain-service=http://127.0.0.1:3004/healthz;notification-service=http://127.0.0.1:3005/healthz;settlement-service=http://127.0.0.1:3006/healthz

# Existing Kufi chain management APIs.
CHAIN_GATEWAY_HEALTH_URL=http://127.0.0.1:8080/health
CHAIN_BOOTSTRAP_MGMT_URL=http://127.0.0.1:9503

# Optional thresholds and future warehouse signals.
WALLET_CONCURRENT_WARN_THRESHOLD=500
DW_STATUS_NOTE=Reserved for future data warehouse feeds that support rate and liquidity decisions.

# Local log tails shown in the web admin app.
WALLET_LOG_SOURCES=
CHAIN_LOG_SOURCES=
SYSTEM_LOG_SOURCES=
