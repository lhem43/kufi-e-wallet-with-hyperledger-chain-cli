PORT=3003
GRPC_URL=0.0.0.0:50053

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=wallet_platform
DB_SYNC=true

EXTERNAL_SETTLE_DELAY_SECONDS=15

# =========================
# External partner adapters
# =========================
# If *_API_BASE_URL is empty, service falls back to local mock behavior.

# MoMo
MOMO_ENABLED=true
MOMO_API_BASE_URL=
MOMO_INITIATE_PATH=/v2/gateway/api/create
MOMO_STATUS_PATH=/v2/gateway/api/query
MOMO_STATUS_METHOD=POST
MOMO_TIMEOUT_MS=8000
MOMO_REQUEST_STYLE=MOMO
MOMO_API_KEY=
MOMO_API_SECRET=
MOMO_CLIENT_ID=
MOMO_MERCHANT_ID=
MOMO_BEARER_TOKEN=
MOMO_API_KEY_HEADER=X-API-Key
MOMO_CLIENT_ID_HEADER=X-Client-Id
MOMO_MERCHANT_ID_HEADER=X-Merchant-Id
MOMO_SIGNATURE_HEADER=X-Signature
MOMO_SIGNATURE_MODE=LEGACY_HEADER_SHA256
MOMO_SIGNATURE_ALGORITHM=sha256
MOMO_SIGNATURE_PAYLOAD_FIELD=signature
MOMO_SIGNATURE_FIELDS=
MOMO_SIGNATURE_JOINER=.
MOMO_EXTRA_HEADERS=
MOMO_INITIATE_STATIC_FIELDS_JSON=
MOMO_CHECK_STATIC_FIELDS_JSON=
# Optional overrides (comma-separated paths/tokens)
MOMO_INITIATE_STATUS_PATHS=
MOMO_INITIATE_REFERENCE_PATHS=
MOMO_INITIATE_MESSAGE_PATHS=
MOMO_CHECK_STATUS_PATHS=
MOMO_CHECK_MESSAGE_PATHS=
MOMO_FAILED_TOKENS=
MOMO_SUCCESS_TOKENS=
MOMO_PENDING_TOKENS=

# VNPAY
VNPAY_ENABLED=true
VNPAY_API_BASE_URL=
VNPAY_INITIATE_PATH=/paymentv2/vpcpay.html
VNPAY_STATUS_PATH=/merchant_webapi/api/transaction
VNPAY_STATUS_METHOD=POST
VNPAY_TIMEOUT_MS=8000
VNPAY_REQUEST_STYLE=VNPAY
VNPAY_API_KEY=
VNPAY_API_SECRET=
VNPAY_CLIENT_ID=
VNPAY_MERCHANT_ID=
VNPAY_BEARER_TOKEN=
VNPAY_API_KEY_HEADER=X-API-Key
VNPAY_CLIENT_ID_HEADER=X-Client-Id
VNPAY_MERCHANT_ID_HEADER=X-Merchant-Id
VNPAY_SIGNATURE_HEADER=X-Signature
VNPAY_SIGNATURE_MODE=VNPAY_QUERY_SHA512
VNPAY_SIGNATURE_ALGORITHM=sha512
VNPAY_SIGNATURE_PAYLOAD_FIELD=vnp_SecureHash
VNPAY_SIGNATURE_FIELDS=
VNPAY_SIGNATURE_JOINER=&
VNPAY_EXTRA_HEADERS=
VNPAY_INITIATE_STATIC_FIELDS_JSON=
VNPAY_CHECK_STATIC_FIELDS_JSON=
VNPAY_INITIATE_STATUS_PATHS=
VNPAY_INITIATE_REFERENCE_PATHS=
VNPAY_INITIATE_MESSAGE_PATHS=
VNPAY_CHECK_STATUS_PATHS=
VNPAY_CHECK_MESSAGE_PATHS=
VNPAY_FAILED_TOKENS=
VNPAY_SUCCESS_TOKENS=
VNPAY_PENDING_TOKENS=

# ZaloPay
ZALOPAY_ENABLED=true
ZALOPAY_API_BASE_URL=
ZALOPAY_INITIATE_PATH=/v2/create
ZALOPAY_STATUS_PATH=/v2/query
ZALOPAY_STATUS_METHOD=POST
ZALOPAY_TIMEOUT_MS=8000
ZALOPAY_REQUEST_STYLE=ZALOPAY
ZALOPAY_API_KEY=
ZALOPAY_API_SECRET=
ZALOPAY_CLIENT_ID=
ZALOPAY_MERCHANT_ID=
ZALOPAY_BEARER_TOKEN=
ZALOPAY_API_KEY_HEADER=X-API-Key
ZALOPAY_CLIENT_ID_HEADER=X-Client-Id
ZALOPAY_MERCHANT_ID_HEADER=X-Merchant-Id
ZALOPAY_SIGNATURE_HEADER=X-Signature
ZALOPAY_SIGNATURE_MODE=ZALOPAY_MAC_SHA256
ZALOPAY_SIGNATURE_ALGORITHM=sha256
ZALOPAY_SIGNATURE_PAYLOAD_FIELD=mac
ZALOPAY_SIGNATURE_FIELDS=app_id,app_trans_id,app_user,amount,app_time,embed_data,item
ZALOPAY_SIGNATURE_JOINER=|
ZALOPAY_EXTRA_HEADERS=
ZALOPAY_INITIATE_STATIC_FIELDS_JSON=
ZALOPAY_CHECK_STATIC_FIELDS_JSON=
ZALOPAY_INITIATE_STATUS_PATHS=
ZALOPAY_INITIATE_REFERENCE_PATHS=
ZALOPAY_INITIATE_MESSAGE_PATHS=
ZALOPAY_CHECK_STATUS_PATHS=
ZALOPAY_CHECK_MESSAGE_PATHS=
ZALOPAY_FAILED_TOKENS=
ZALOPAY_SUCCESS_TOKENS=
ZALOPAY_PENDING_TOKENS=

